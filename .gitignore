# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地备份文件（改代码前手动留的，绝不能进公开仓库）
# 🔴 2026-11-12：分隔符要一并覆盖。旧规则只有 *.bak 和 *.bak.*，
#    于是 ac.py.bak_20261112_1637（用下划线）既不被忽略、也不被扫描器拦下，
#    会 git add -A 直接推上公开仓库。这里把 . / _ / - 三种分隔符都写上。
*.bak
*.bak.*
*.bak_*
*.bak-*
*.old
*.old.*
*.old_*
*.old-*
*.orig
*.orig.*
*.orig_*
*.orig-*
*.tmp
*.tmp.*
*.tmp_*
*.tmp-*
*~

# 本机凭据（绝对不能提交）
.env
*.key
*_key.json
agnes-clip.json
ai-video-pipeline.json

# 打包产物（按需：想让 Releases 里留 zip 就删掉下面两行）
dist/*.zip
dist/*.sha256

# 平哥自己的发布操作手册（对外发布不需要，tools/publish.py 会自动排除）
发布指南.md

# 项目产物（跑片子时生成的，别混进 skill 仓库）
projects/
out/
frames/
clips/
*.mp4

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
